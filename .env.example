# Flask Configuration
FLASK_SECRET_KEY=replace-with-a-secure-random-secret-key
FLASK_APP=run.py
FLASK_ENV=development

# Database Configuration (MySQL)
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=documind

# Optional direct database connection string (MySQL or SQLite)
# Example MySQL: mysql+pymysql://root:password@localhost:3306/documind
# Example SQLite: sqlite:///instance/documind.db
DATABASE_URL=mysql+pymysql://root:@localhost:3306/documind

# Upload Settings
MAX_CONTENT_LENGTH=33554432

# AI Intelligence Engine (Gemini / OpenAI)
AI_PROVIDER=gemini
AI_API_KEY=your_api_key_here
AI_MODEL=gemini-2.5-flash
